{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "prebuildCommand": "npx expo prebuild --platform android --clean && sed -i 's/.*splashscreen_logo.*//g' android/app/src/main/res/values/values.xml"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {}
    }
  }
}