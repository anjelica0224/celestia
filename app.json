{
  "expo": {
    "name": "celestia",
    "slug": "celestia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "celestia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.celestia.app"
    },
    "android": {
      "package": "com.celestia.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "buildCacheProvider": "eas"
    },
    "expo": {
      "splash": {
        "backgroundColor": "#000000"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "536613f2-2ba3-4a9e-aa04-3525b023ece4"
      }
    },
    "owner": "ajraghwa"
  }
}
